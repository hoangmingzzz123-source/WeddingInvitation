# Public browser configuration. The publishable key is safe to expose only when RLS is enabled.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Optional. Set to a domain you own with a wildcard DNS record and Vercel domain assignment.
# Leave empty to use /invite/slug links on the main site.
VITE_PUBLIC_INVITATION_DOMAIN=

# Vercel Function configuration. Never prefix the secret key with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Optional public app origin used to package the exact built CSS and fonts into invitation ZIP exports.
PUBLIC_APP_URL=

# Optional. Defaults to 60 new sessions per hour across the site.
UPLOAD_LIMIT_PER_HOUR=60
# Optional stable server-only HMAC secret. Falls back to SUPABASE_SECRET_KEY.
UPLOAD_ABUSE_SECRET=
# Optional Drive and cleanup worker configuration.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
CRON_SECRET=

